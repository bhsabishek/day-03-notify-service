# Copy this file to .env and fill in your own values. Never commit .env.

# Address of the Vault server (local dev Vault by default).
VAULT_ADDR=http://127.0.0.1:8200

# Scoped, read-only Vault token for secret/notify. Never use the root token.
VAULT_TOKEN=hvs.CAESIFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE

# The API key and SMTP password are NOT set here. They are stored in Vault.
